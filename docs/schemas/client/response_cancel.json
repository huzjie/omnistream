{
  "$defs": {
    "StopReason": {
      "enum": [
        "completed",
        "interrupted",
        "cancelled",
        "timeout",
        "error",
        "max_duration",
        "tool_pending"
      ],
      "title": "StopReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "``response.cancel`` —— 取消当前生成（客户端侧打断）。",
