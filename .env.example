# =========================================================================
# OmniStream 环境配置示例 —— 复制为 .env 后按需修改
# =========================================================================

# --- 应用 ---
OMS_APP__NAME=OmniStream
OMS_HOST=0.0.0.0
OMS_PORT=8000
OMS_DEBUG=false
OMS_SECRET_KEY=change-me-to-a-long-random-string

# --- Provider 默认值（mock 模式：零 API Key、零 GPU 即可端到端跑通） ---
OMS_PROVIDERS__DEFAULT=mock
OMS_PROVIDERS__ALLOWED=["mock","doubao","openai","gemini","qwen","deepseek","kimi","local"]

# Doubao SeedRealtime
OMS_PROVIDERS__DOUBao__API_KEY=sk_*_REDACTED_EXAMPLE_*
OMS_PROVIDERS__DOUBao__BASE_URL=https://api.doubao.com/v1

# OpenAI Realtime API
OMS_PROVIDERS__OPENAI__API_KEY=sk_*_REDACTED_EXAMPLE_*
OMS_PROVIDERS__OPENAI__BASE_URL=https://api.openai.com/v1

# Gemini Live
OMS_PROVIDERS__GEMINI__API_KEY=sk_*_REDACTED_EXAMPLE_*

# Qwen-Omni
OMS_PROVIDERS__QWEN__API_KEY=sk_*_REDACTED_EXAMPLE_*

# DeepSeek V4
OMS_PROVIDERS__DEEPSEEK__API_KEY=sk_*_REDACTED_EXAMPLE_*

# Kimi K3
OMS_PROVIDERS__KIMI__API_KEY=sk_*_REDACTED_EXAMPLE_*

# --- 存储 ---
# 默认 SQLite（零配置可跑）；生产建议 PostgreSQL
OMS_STORAGE__DATABASE_URL=sqlite:///./data/omnistream.db
OMS_STORAGE__REDIS_URL=redis://localhost:6379/0
OMS_STORAGE__USE_REDIS=false

# --- 全双工内核 ---
OMS_DUPLEX__VAD_ENGINE=energy        # energy | webrtc | silero
OMS_DUPLEX__VAD_THRESHOLD=0.4
OMS_DUPLEX__MAX_TURN_SECONDS=30
OMS_DUPLEX__SILENCE_TIMEOUT_MS=900

# --- 感知管线 ---
OMS_PERCEPTION__ASR_ENGINE=mock       # mock | faster-whisper | cloud
OMS_PERCEPTION__TTS_ENGINE=mock       # mock | piper | cloud
OMS_PERCEPTION__VLM_ENABLED=true

# --- 主动记忆 ---
OMS_MEMORY__ENABLED=true
OMS_MEMORY__VECTOR_BACKEND=numpy      # chroma | numpy
OMS_MEMORY__RELEVANCE_THRESHOLD=0.55
OMS_MEMORY__CONFIDENCE_THRESHOLD=0.6
